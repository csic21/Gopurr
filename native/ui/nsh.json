{
  "name": "Gopurr",
  "id": "io.github.gopurr.nsh.preview",
  "version": "0.6.37",
  "build": 1,
  "icon": "assets/icon-master.png",
  "statusBar": {
    "foreground": "auto"
  },
  "capabilities": {
    "host": [
      "engine.dispatch",
      "desktop.dispatch",
      "desktop.file.open",
      "desktop.file.save",
      "desktop.clipboard.write",
      "desktop.openURL",
      "desktop.reveal",
      "desktop.window.close",
      "desktop.window.dirty",
      "android.session",
      "android.connect",
      "android.disconnect",
      "android.apps",
      "android.scope.get",
      "android.scope.set",
      "android.file.pick",
      "android.notifications",
      "android.notifications.request",
      "android.notifications.settings",
      "android.notifications.configure",
      "android.appearance",
      "android.update",
      "android.update.check",
      "android.update.download",
      "android.update.cancel",
      "android.update.install"
    ],
    "statusBar": true
  }
}
